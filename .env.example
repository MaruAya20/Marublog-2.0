# ========================================
# MaruBlog 本地开发环境变量
# 复制此文件为 .env 后填入真实值
# .env 已在 .gitignore 中排除，不会被提交
# ========================================

# --- Spring AI / DeepSeek 配置 ---
# 你的 DeepSeek API Key（在 https://platform.deepseek.com 申请）
AI_API_KEY=

# API 地址（DeepSeek 官方默认即可）
AI_BASE_URL=https://api.deepseek.com

# 模型：deepseek-chat（快速）或 deepseek-reasoner（思考模式）
AI_MODEL=deepseek-chat

# 输出 token 上限（deepseek-chat 支持最高 8192，建议 2048 控制成本）
AI_MAX_TOKENS=2048

# 重要：设为空值以启用 AI 功能；保留默认则禁用（无 API Key 时安全降级）
AI_EXCLUDE=

# --- 限流（可选，默认值一般够用）---
# 单用户每天最多 AI 对话次数
AI_PER_USER_DAILY=100

# 单 IP 每分钟最多请求次数（防滥用）
AI_PER_IP_MINUTE=10

# 单条消息最大字符数
AI_MAX_INPUT_CHARS=1500

# --- JWT（生产环境一定要改！）---
JWT_SECRET=dev-secret-change-me-in-production-please-1234567890

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=